{
  "version": 2,
  "rewrites": [
    { "source": "/api/bumn", "destination": "/data/bumn_maganghub.json" },
    { "source": "/api/download/csv", "destination": "/data/bumn_maganghub.csv" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
